{
  "name": "config-drift-timeline-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "build:cli": "cargo build --release",
    "build": "npm run build:cli && npm run build:site",
    "test:site": "node --test site/tests/site.test.mjs",
    "test:e2e": "npm run build:site && node site/tests/e2e.mjs",
    "test": "cargo test && npm run test:site && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "playwright": "1.58.2",
    "vite": "7.3.6"
  }
}
